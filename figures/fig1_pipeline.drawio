;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n118" target="n106"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n132" value="&lt;b&gt;Signals&lt;/b&gt;&lt;br&gt;&lt;i&gt;s&lt;/i&gt;&lt;sub&gt;1&lt;/sub&gt;, &lt;i&gt;s&lt;/i&gt;&lt;sub&gt;2&lt;/sub&gt;: dense similarity&lt;br&gt;of fused ranks 1 and 2&lt;br&gt;&lt;i&gt;m&lt;/i&gt; = (&lt;i&gt;s&lt;/i&gt;&lt;sub&gt;1&lt;/sub&gt; &amp;minus; &lt;i&gt;s&lt;/i&gt;&lt;sub&gt;2&lt;/sub&gt;) / &lt;i&gt;s&lt;/i&gt;&lt;sub&gt;1&lt;/sub&gt;" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeWidth=1.2;strokeColor=#C9A227;fontFamily=Helvetica;fontSize=15;fontColor=#1A1A1A;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="556" y="84" width="233" height="104" as="geometry"/></mxCell><mxCell id="n133" value="&lt;b&gt;Confidence score&lt;/b&gt;&lt;br&gt;&lt;i&gt;C&lt;/i&gt; = &amp;alpha;&lt;i&gt;s&lt;/i&gt;&lt;sub&gt;1&lt;/sub&gt; + (1 &amp;minus; &amp;alpha;)&lt;i&gt;m&lt;/i&gt;&lt;br&gt;&amp;alpha; = 0.6,&amp;nbsp; 0 &amp;le; &lt;i&gt;C&lt;/i&gt; &amp;le; 1" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeWidth=1.2;strokeColor=#C9A227;fontFamily=Helvetica;fontSize=15;fontColor=#1A1A1A;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="556" y="216" width="233" height="92" as="geometry"/></mxCell><mxCell id="n134" value="Top record found only&lt;br&gt;by BM25: &lt;i&gt;s&lt;/i&gt;&lt;sub&gt;1&lt;/sub&gt; = 0, so &lt;i&gt;C&lt;/i&gt; = 0" style="rounded=1;arcSize=8;dashed=1;fillColor=#FFFFFF;strokeColor=#C9A227;strokeWidth=1.2;fontSize=14;fontFamily=Helvetica;fontSize=15;fontColor=#1A1A1A;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="556" y="332" width="233" height="62" as="geometry"/></mxCell><mxCell id="n135" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#404040;fontFamily=Helvetica;fontSize=15;fontColor=#1A1A1A;fontStyle=1;html=1;" edge="1" parent="1" source="n132" target="n133"><mxGeo